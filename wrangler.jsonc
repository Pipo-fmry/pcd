{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcd",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pcd",
      "database_id": "e2ae7726-0003-4643-a4bd-d9bf05a3671d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
