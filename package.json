{
  "name": "pcd",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 5793",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pcd --local",
    "db:migrate": "wrangler d1 migrations apply pcd --remote",
    "seed:build": "node scripts/import-carnet.mjs",
    "seed:local": "wrangler d1 execute pcd --local --file seed/carnet.sql",
    "seed": "wrangler d1 execute pcd --remote --file seed/carnet.sql",
    "check": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "wrangler": "^4.158.0"
  }
}
